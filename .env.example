# Copy this to .env and fill in real values. Never commit the real .env file.

# --- Identity provider (any OpenID Connect provider) ---------------------
#
# OIDC_ISSUER must equal the "issuer" value in the provider's discovery
# document EXACTLY, including a trailing slash if there is one. Open
#   <issuer>/.well-known/openid-configuration
# in a browser and copy the value from there rather than typing it.
#
# The value below only shows the shape of an Auth0 issuer. See the README for
# step-by-step Auth0 setup.
OIDC_ISSUER=https://your-tenant.example.auth0.com/
OIDC_CLIENT_ID=your-client-id
OIDC_CLIENT_SECRET=your-client-secret
# Must be registered with the provider as an allowed callback URL.
# Local development: http://localhost:8000/auth/callback
OIDC_REDIRECT_URI=https://secrets.example.com/auth/callback

# Optional. Only needed if the provider does not publish its discovery
# document at <issuer>/.well-known/openid-configuration.
# Asgardeo: https://api.asgardeo.io/t/YOUR_ORG/oauth2/token/.well-known/openid-configuration
# OIDC_DISCOVERY_URL=

# --- App behaviour --------------------------------------------------------
SESSION_TTL_MINUTES=30
SECRET_TTL_MINUTES=1440
DATABASE_URL=sqlite:///./data/app.db

# "production" (the default if unset) or "development".
# development = cookies work over plain http://localhost and the provider
# URLs may be http. Never set it on a public deployment.
ENVIRONMENT=production

# --- Abuse limits (defaults shown) ---------------------------------------
# CREATE_RATE_LIMIT_PER_MINUTE=10
# MAX_LIVE_SECRETS=1000
# Number of reverse proxies in front of the app (0 = none). docker-compose.yml
# sets this to 1 for the nginx deployment; leave it unset for local runs.
# TRUSTED_PROXY_HOPS=0

# There is deliberately no encryption key here. Secrets are encrypted in the
# sender's browser; the server never holds a key that could decrypt them.
