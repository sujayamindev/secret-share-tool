# Copy this to .env and fill in real values. Never commit the real .env file.

# Asgardeo OIDC app credentials (from console.asgardeo.io -> your app -> Protocol tab)
ASGARDEO_BASE_URL=https://api.asgardeo.io/t/your-org-name
ASGARDEO_CLIENT_ID=your-client-id
ASGARDEO_CLIENT_SECRET=your-client-secret
ASGARDEO_REDIRECT_URI=https://secrets.sujaya.dev/auth/callback

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=change-me

SESSION_TTL_MINUTES=30
SECRET_TTL_MINUTES=1440
DATABASE_URL=sqlite:///./data/app.db
ENVIRONMENT=development
